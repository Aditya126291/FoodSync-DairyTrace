# Copy to .env (never commit the real file).

# --- Security ---
APP_ENV=development            # set to "production" to enforce a real JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local development defaults to backend/dairytrace.db (SQLite).
# Production requires a managed PostgreSQL URL with a database/user created in advance.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dairytrace?sslmode=require
# APP_ENV=production
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_SSLMODE=require

# --- AI complaint copilot (optional). Without a key the rule-based extractor is used. ---
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Demo accounts (used only by `python -m app.manage seed`) ---
# DEMO_INSPECTOR_PASSWORD=Inspect@2026
# DEMO_QA_PASSWORD=QaOfficer@2026
