# DairyTrace Backend Environment Configuration
# Copy this file to backend/.env and adjust as needed. Never commit real secrets.

# Application environment ("development" or "production")
APP_ENV=development

# JWT Session Signing Secret (REQUIRED when APP_ENV=production)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
TOKEN_TTL_MINUTES=480

# SQLite or PostgreSQL Database URL
DATABASE_URL=sqlite:///./dairytrace.db

# Allowed Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional Groq API Key for AI Complaint Copilot (LangGraph + Llama 3.3 70B)
# If omitted, the deterministic regex + dairy domain extractor runs automatically.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
